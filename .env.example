# ─── Segurança ─────────────────────────────────────────────────────────────────
HELIOS_JWT_SECRET=<random-64-chars>
HELIOS_ENCRYPTION_KEY=<random-32-bytes-hex>

# ─── Banco ─────────────────────────────────────────────────────────────────────
HELIOS_DB_PATH=./data/helios.db

# ─── API ───────────────────────────────────────────────────────────────────────
HELIOS_API_PORT=3000
HELIOS_API_HOST=0.0.0.0

# ─── Frontend ──────────────────────────────────────────────────────────────────
HELIOS_FRONTEND_URL=http://localhost:4200

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
HELIOS_RATE_LIMIT_MAX=100
HELIOS_RATE_LIMIT_WINDOW_MS=60000

# ─── Growatt ───────────────────────────────────────────────────────────────────
HELIOS_GROWATT_BASE_URL=https://openapi.growatt.com/v1
HELIOS_CACHE_TTL_MS=300000

# ─── Token da Growatt Open API V1 (usado em DEV pelo frontend) ─────────────────
# Obtenha em: https://openapi.growatt.com/
GROWATT_API_TOKEN=seu_token_aqui
