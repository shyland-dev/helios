{
  "name": "helios-api",
  "version": "0.0.1",
  "description": "Helios backend API — Fastify + TypeScript + SQLite",
  "engines": {
    "node": "24.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "cli": "tsx cli/index.ts",
    "format": "prettier --write .",
    "lint": "eslint src/ cli/"
  },
  "private": true,
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.6.0",
    "@fastify/swagger-ui": "6.0.0",
    "bcrypt": "6.0.0",
    "better-sqlite3": "13.0.3",
    "commander": "^15.0.0",
    "fastify": "5.12.0",
    "fastify-plugin": "6.0.0",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcrypt": "5.0.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.15.21",
    "eslint": "10.3.0",
    "prettier": "3.8.1",
    "tsx": "4.19.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true
  }
}
