{
  "name": "helios",
  "version": "0.0.1",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "postinstall": "npm run sync-version && npm run format-n-lint",
    "ng": "ng",
    "prebuild": "npm run sync-version && npm run format-n-lint",
    "prestart": "npm run sync-version && npm run format-n-lint",
    "start": "node scripts/load-env.mjs ng serve",
    "build": "node scripts/load-env.mjs ng build",
    "sync-version": "node scripts/sync-version.mjs",
    "format-n-lint": "npm run format && npm run lint",
    "format": "prettier --write .",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@shyland-dev/ui": "^0.0.17",
    "@shyland-dev/utils": "^0.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
